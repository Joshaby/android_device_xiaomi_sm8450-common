# Audio
audio.offload.min.duration.secs=30
media.stagefright.audio.deep=false

# Camera
log.tag.CHIUSECASE=ERROR
camera.disable_zsl_mode=true
ro.camera.enableCamera1MaxZsl=1

# Display
debug.sf.frame_rate_multiple_threshold=120
debug.sf.auto_latch_unsignaled=0
debug.sf.disable_client_composition_cache=1
debug.sf.enable_transaction_tracing=false
debug.sf.enable_gl_backpressure=0
debug.sf.enable_hwc_vds=0
debug.sf.hw=0
debug.sf.predict_hwc_composition_strategy=0
debug.sf.set_idle_timer_ms=1000
debug.sf.treat_170m_as_sRGB=1
debug.sf.use_phase_offsets_as_durations=0
debug.sf.enable_adpf_cpu_hint=true
debug.sf.early.app.duration=18000000
debug.sf.early.sf.duration=20000000
debug.sf.late.app.duration=18000000  
debug.sf.late.sf.duration=20000000

# Graphics
debug.egl.hw=0
ro.gfx.driver.1=com.qualcomm.qti.gpudrivers.taro.api31
ro.hardware.egl=adreno
ro.hardware.vulkan=adreno
ro.opengles.version=196610
ro.surface_flinger.enable_frame_rate_override=false
ro.surface_flinger.force_hwc_copy_for_virtual_displays=true
ro.surface_flinger.game_default_frame_rate_override=120
ro.surface_flinger.has_HDR_display=true
ro.surface_flinger.has_wide_color_display=true
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.max_virtual_display_dimension=4096
ro.surface_flinger.protected_contents=true
ro.surface_flinger.set_idle_timer_ms?=1000
ro.surface_flinger.set_touch_timer_ms=1000
ro.surface_flinger.supports_background_blur=1
ro.surface_flinger.use_color_management=true
ro.surface_flinger.use_content_detection_for_refresh_rate=true
ro.surface_flinger.wcg_composition_dataspace=143261696
ro.surface_flinger.clear_slots_with_set_layer_buffer=true
ro.surface_flinger.support_kernel_idle_timer=true
ro.sf.blurs_are_expensive=1

# HWUI
debug.hwui.skia_atrace_enabled=false
debug.hwui.use_hint_manager=true
debug.hwui.target_cpu_time_percent=30

# Media
media.stagefright.thumbnail.prefer_hw_codecs=true
debug.c2.use_dmabufheaps=1
debug.stagefright.c2inputsurface=-1

# Radio
ril.subscription.types=NV,RUIM
ro.telephony.default_network=33,33
telephony.active_modems.max_count=2
telephony.lteOnCdmaDevice=1

# System
persist.sys.fuse.passthrough.enable=true
persist.sys.sf.color_mode=0
persist.sys.sf.color_saturation=1.0
persist.sys.sf.native_mode=258
ro.incremental.enable=yes
ro.hardware.keystore_desede=true
activity_manager.max_cached_processes=64
power.saving.mode=1
pm.sleep_mode=1

# Debug
persist.dbg.volte_avail_ovr=1
persist.dbg.vt_avail_ovr=1
persist.dbg.wfc_avail_ovr=1
persist.debug.wfd.enable=1
debug.graphics.game_default_frame_rate.disabled=1

# USB
sys.usb.mtp.batchcancel=1

# WiFi
wifi.aware.interface=wifi-aware0

# DRM
drm.service.enabled=true

# FRP
ro.frp.pst=/dev/block/bootdevice/by-name/frp

# Dex2oat
dalvik.vm.dex2oat64.enabled=true